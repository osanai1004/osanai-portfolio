---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Atmosphere from '../../components/Atmosphere.astro';
import StrengthCard from '../../components/StrengthCard.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import PersonName from '../../components/PersonName.astro';
import HeroTerminal from '../../components/HeroTerminal.astro';
import Contributions from '../../components/Contributions.astro';
import { LOCALES, SITE, type Locale } from '../../lib/site';
import { useTranslations, type UiKey } from '../../lib/i18n/ui';
import { HERO_STACK, SKILL_GROUPS } from '../../lib/profile';
import { getStrengths } from '../../lib/strengths';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const strengths = getStrengths();

const timeline = [1, 2, 3, 4].map((n) => ({
	period: t(`about.tl${n}.period` as UiKey),
	title: t(`about.tl${n}.title` as UiKey),
	desc: t(`about.tl${n}.desc` as UiKey),
	current: n === 4,
}));

const qaItems = [1, 2, 3].map((n) => ({
	q: t(`about.qa${n}.q` as UiKey),
	a: t(`about.qa${n}.a` as UiKey),
}));
---

<Base locale={locale}>
	<!-- Hero -->
	<section class="hero-band">
		<Atmosphere variant="hero" />
		<div class="hero container">
			<div class="hero-copy reveal">
				<p class="eyebrow">{t('hero.eyebrow')}</p>
				<h1 class="display-lg hero-name"><PersonName locale={locale} variant="hero" /></h1>
				<p class="body-lg hero-tagline">{t('hero.tagline')}</p>
				<div class="hero-actions">
					<a class="button-primary" href="#strengths">{t('hero.cta.strengths')}</a>
					<a class="button-secondary" href={SITE.githubUrl} rel="noopener noreferrer" target="_blank">
						{t('hero.cta.github')} ↗
					</a>
				</div>
			</div>

			<aside class="hero-panel reveal reveal-delay" aria-label={t('hero.panel.label')}>
				<div class="panel-chrome">
					<span class="chrome-dot"></span>
					<span class="chrome-dot"></span>
					<span class="chrome-dot"></span>
					<span class="chrome-title caption">{t('hero.panel.label')}</span>
				</div>
				<HeroTerminal locale={locale} />
				<p class="caption panel-stack-label">{t('hero.panel.stack')}</p>
				<ul class="panel-stack">
					{
						HERO_STACK.map((item) => (
							<li class="stack-chip">
								<BrandLogo id={item.id} size={16} />
								<span class="chip-label">{item.label}</span>
							</li>
						))
					}
				</ul>
			</aside>
		</div>
	</section>

	<!-- About -->
	<Section id="about" eyebrow={t('about.eyebrow')} title={t('about.title')} atmosphere="about">
		<p class="about-intro body-lg">{t('about.intro')}</p>
		<div class="about-grid">
			<div class="about-col">
				<p class="caption about-col-label">{t('about.timelineLabel')}</p>
				<ol class="timeline">
					{
						timeline.map((item) => (
							<li class:list={['timeline-item', item.current && 'timeline-current']}>
								<span class="timeline-marker" aria-hidden="true" />
								<p class="caption timeline-period">{item.period}</p>
								<h3 class="body-lg timeline-title">{item.title}</h3>
								<p class="body-sm timeline-desc">{item.desc}</p>
							</li>
						))
					}
				</ol>
			</div>
			<div class="about-col">
				<p class="caption about-col-label">{t('about.qaLabel')}</p>
				<dl class="qa-list">
					{
						qaItems.map((item) => (
							<div class="qa-card">
								<dt class="qa-q">
									<span class="qa-mark" aria-hidden="true">
										Q
									</span>
									<span class="qa-q-text">{item.q}</span>
								</dt>
								<dd class="body-sm qa-a">{item.a}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</Section>

	<!-- Skills + Activity -->
	<Section id="skills" eyebrow={t('skills.eyebrow')} title={t('skills.title')} atmosphere="skills">
		<div class="skills-board">
			{
				SKILL_GROUPS.map((group) => (
					<div class="skill-row">
						<h3 class="skill-category caption">{t(group.categoryKey as UiKey)}</h3>
						<ul class="skill-chips">
							{group.items.map((item) => (
								<li class="stack-chip">
									<BrandLogo id={item.id} size={16} />
									<span class="chip-label">{item.label}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<Contributions locale={locale} />
	</Section>

	<!-- Strengths（課題解決・強み） -->
	<Section id="strengths" eyebrow={t('strengths.eyebrow')} title={t('strengths.title')}>
		<p class="strengths-lead body-sm">{t('strengths.lead')}</p>
		<div class="strengths-grid">
			{strengths.map((strength) => <StrengthCard strength={strength} locale={locale} />)}
		</div>
	</Section>

	<!-- Contact -->
	<section class="container contact-wrap" id="contact">
		<div class="cta-banner">
			<div class="cta-copy">
				<p class="eyebrow">{t('contact.eyebrow')}</p>
				<h2 class="headline cta-title">{t('contact.title')}</h2>
				<p class="cta-body">{t('contact.body')}</p>
			</div>
			<a class="button-primary" href={SITE.githubUrl} rel="noopener noreferrer" target="_blank">
				{t('contact.cta')} ↗
			</a>
		</div>
	</section>
</Base>

<style>
	/* ---- Buttons ---- */
	.button-primary {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: var(--space-xs) 14px;
		font-size: var(--text-body-sm-size);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-on-primary);
		background-color: var(--color-primary);
		border-radius: var(--rounded-md);
	}

	.button-primary:hover {
		background-color: var(--color-primary-hover);
	}

	.button-secondary {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: var(--space-xs) 14px;
		font-size: var(--text-body-sm-size);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-ink);
		background-color: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-md);
	}

	.button-secondary:hover {
		background-color: var(--color-surface-2);
		border-color: var(--color-hairline-strong);
	}

	/* ---- Shared compact chip（Skills / Hero 共通） ---- */
	.stack-chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 32px;
		padding: 0 10px 0 9px;
		border-radius: var(--rounded-md);
		background: var(--color-surface-2);
		border: 1px solid var(--color-hairline);
		color: var(--color-ink);
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.stack-chip:hover {
		border-color: var(--color-hairline-strong);
		background: var(--color-surface-3);
	}

	.chip-label {
		font-size: 13px;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	/* ---- Hero ---- */
	.hero-band {
		position: relative;
		isolation: isolate;
		overflow: hidden;
	}

	.hero {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: var(--space-xxl);
		/* center だと全文が画面中央に浮き、スクロール済みに見える */
		align-items: start;
		padding-top: calc(var(--space-section) - 16px);
		padding-bottom: var(--space-xxl);
		min-height: calc(100dvh - var(--nav-height) - var(--space-xxl));
	}

	.hero-name {
		margin-top: var(--space-xs);
	}

	.hero-tagline {
		max-width: 36em;
		margin-top: var(--space-lg);
		color: var(--color-ink-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
	}

	.hero-panel {
		position: relative;
		padding: var(--space-lg);
		background-color: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xl);
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
	}

	.panel-chrome {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: var(--space-md);
	}

	.chrome-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-hairline-strong);
	}

	.chrome-title {
		margin-left: auto;
		color: var(--color-ink-tertiary);
		font-family: var(--font-mono);
	}

	.panel-stack-label {
		margin-top: var(--space-md);
		padding-top: var(--space-md);
		border-top: 1px solid var(--color-hairline);
		color: var(--color-ink-tertiary);
		font-family: var(--font-mono);
	}

	.panel-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.reveal {
		animation: rise 0.55s ease both;
	}

	.reveal-delay {
		animation-delay: 0.12s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ---- About ---- */
	.about-intro {
		max-width: 44em;
		margin-top: calc(var(--space-md) * -1);
		margin-bottom: var(--space-xl);
		color: var(--color-ink-muted);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: var(--space-xxl);
		align-items: start;
	}

	.about-col-label {
		margin-bottom: var(--space-md);
		color: var(--color-ink-subtle);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* ---- About: タイムライン ---- */
	.timeline {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		padding-left: 2px;
	}

	.timeline-item {
		position: relative;
		padding-left: 28px;
	}

	/* 縦のライン（最後のノードまで） */
	.timeline-item::before {
		content: '';
		position: absolute;
		top: 18px;
		bottom: calc(var(--space-lg) * -1);
		left: 5px;
		width: 1px;
		background: linear-gradient(
			to bottom,
			var(--color-hairline-strong),
			var(--color-hairline)
		);
	}

	.timeline-item:last-child::before {
		display: none;
	}

	.timeline-marker {
		position: absolute;
		top: 5px;
		left: 0;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--color-surface-2);
		border: 1px solid var(--color-hairline-strong);
	}

	.timeline-current .timeline-marker {
		background: var(--color-primary);
		border-color: var(--color-primary);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 22%, transparent);
	}

	.timeline-period {
		color: var(--color-ink-tertiary);
		font-family: var(--font-mono);
	}

	.timeline-current .timeline-period {
		color: var(--color-primary);
	}

	.timeline-title {
		margin-top: var(--space-xxs);
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.timeline-desc {
		margin-top: var(--space-xxs);
		max-width: 38em;
		color: var(--color-ink-muted);
	}

	/* ---- About: Q&A ---- */
	.qa-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.qa-card {
		padding: var(--space-md) var(--space-lg);
		background-color: color-mix(in srgb, var(--color-surface-1) 88%, transparent);
		backdrop-filter: blur(8px);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-lg);
		box-shadow: 0 8px 28px color-mix(in srgb, #000 18%, transparent);
	}

	.qa-q {
		display: flex;
		align-items: baseline;
		gap: 10px;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.qa-mark {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border-radius: 6px;
		background: color-mix(in srgb, var(--color-primary) 14%, transparent);
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		font-family: var(--font-mono);
		transform: translateY(3px);
	}

	.qa-a {
		margin-top: var(--space-xs);
		padding-left: 32px;
		color: var(--color-ink-muted);
	}

	/* ---- Skills（コンパクトな行レイアウト） ---- */
	.skills-board {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		padding: var(--space-xl);
		background: color-mix(in srgb, var(--color-surface-1) 90%, transparent);
		backdrop-filter: blur(8px);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xl);
		box-shadow: 0 10px 32px color-mix(in srgb, #000 16%, transparent);
	}

	.skill-row {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: var(--space-md);
		align-items: center;
	}

	.skill-category {
		color: var(--color-ink-subtle);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.skill-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	/* ---- Strengths ---- */
	.strengths-lead {
		max-width: 46em;
		margin-top: calc(var(--space-md) * -1);
		margin-bottom: var(--space-xl);
		color: var(--color-ink-muted);
	}

	.strengths-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-md);
	}

	/* ---- Contact ---- */
	.contact-wrap {
		padding-top: var(--space-section);
	}

	.cta-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-xl);
		padding: var(--space-xxl);
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 10%, transparent), transparent 42%),
			var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xl);
	}

	.cta-copy {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.cta-body {
		max-width: 36em;
		color: var(--color-ink-muted);
	}

	@media (max-width: 1024px) {
		.strengths-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			gap: var(--space-xl);
			padding-top: var(--space-xxl);
		}

		.about-grid,
		.strengths-grid {
			grid-template-columns: 1fr;
		}

		.about-grid {
			gap: var(--space-xl);
		}

		.timeline {
			gap: var(--space-md);
		}

		.timeline-item::before {
			bottom: calc(var(--space-md) * -1);
		}

		.skill-row {
			grid-template-columns: 1fr;
			gap: var(--space-xs);
		}

		.skills-board {
			padding: var(--space-lg);
		}

		.cta-banner {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal,
		.reveal-delay {
			animation: none;
		}
	}
</style>
