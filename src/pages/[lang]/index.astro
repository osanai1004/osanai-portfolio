---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import { LOCALES, SITE, type Locale } from '../../lib/site';
import { useTranslations, type UiKey } from '../../lib/i18n/ui';
import { HERO_STACK, SKILL_GROUPS } from '../../lib/profile';

export function getStaticPaths() {
	return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const projects = (await getCollection('projects', (entry) => entry.id.startsWith(`${locale}/`))).sort(
	(a, b) => a.data.order - b.data.order,
);

const stats = [
	{ value: t('about.stat1.value'), label: t('about.stat1.label') },
	{ value: t('about.stat2.value'), label: t('about.stat2.label') },
	{ value: t('about.stat3.value'), label: t('about.stat3.label') },
];
---

<Base locale={locale}>
	<!-- Hero -->
	<section class="hero container">
		<div class="hero-copy reveal">
			<p class="eyebrow">{t('hero.eyebrow')}</p>
			<h1 class="display-lg hero-name">{t('hero.name')}</h1>
			<p class="body-lg hero-tagline">{t('hero.tagline')}</p>
			<div class="hero-actions">
				<a class="button-primary" href="#projects">{t('hero.cta.projects')}</a>
				<a class="button-secondary" href={SITE.githubUrl} rel="noopener noreferrer" target="_blank">
					{t('hero.cta.github')} ↗
				</a>
			</div>
		</div>

		<aside class="hero-panel reveal reveal-delay" aria-label={t('hero.panel.label')}>
			<div class="panel-chrome">
				<span class="chrome-dot"></span>
				<span class="chrome-dot"></span>
				<span class="chrome-dot"></span>
				<span class="chrome-title caption">{t('hero.panel.label')}</span>
			</div>
			<p class="panel-role body-sm">{t('hero.panel.role')}</p>
			<ul class="panel-stack">
				{
					HERO_STACK.map((item) => (
						<li class="stack-chip">
							<BrandLogo id={item.id} size={16} />
							<span class="chip-label">{item.label}</span>
						</li>
					))
				}
			</ul>
		</aside>
	</section>

	<!-- About -->
	<Section id="about" eyebrow={t('about.eyebrow')} title={t('about.title')}>
		<div class="about-grid">
			<div class="about-body">
				<p class="body-lg">{t('about.body1')}</p>
				<p>{t('about.body2')}</p>
			</div>
			<dl class="stats">
				{
					stats.map((stat) => (
						<div class="stat-card">
							<dt class="caption stat-label">{stat.label}</dt>
							<dd class="headline stat-value">{stat.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</Section>

	<!-- Skills -->
	<Section id="skills" eyebrow={t('skills.eyebrow')} title={t('skills.title')}>
		<div class="skills-board">
			{
				SKILL_GROUPS.map((group) => (
					<div class="skill-row">
						<h3 class="skill-category caption">{t(group.categoryKey as UiKey)}</h3>
						<ul class="skill-chips">
							{group.items.map((item) => (
								<li class="stack-chip">
									<BrandLogo id={item.id} size={16} />
									<span class="chip-label">{item.label}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</Section>

	<!-- Projects -->
	<Section id="projects" eyebrow={t('projects.eyebrow')} title={t('projects.title')}>
		<div class="projects-grid">
			{projects.map((project) => <ProjectCard project={project} locale={locale} />)}
		</div>
	</Section>

	<!-- Contact -->
	<section class="container contact-wrap" id="contact">
		<div class="cta-banner">
			<div class="cta-copy">
				<p class="eyebrow">{t('contact.eyebrow')}</p>
				<h2 class="headline cta-title">{t('contact.title')}</h2>
				<p class="cta-body">{t('contact.body')}</p>
			</div>
			<a class="button-primary" href={SITE.githubUrl} rel="noopener noreferrer" target="_blank">
				{t('contact.cta')} ↗
			</a>
		</div>
	</section>
</Base>

<style>
	/* ---- Buttons ---- */
	.button-primary {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: var(--space-xs) 14px;
		font-size: var(--text-body-sm-size);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-on-primary);
		background-color: var(--color-primary);
		border-radius: var(--rounded-md);
	}

	.button-primary:hover {
		background-color: var(--color-primary-hover);
	}

	.button-secondary {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: var(--space-xs) 14px;
		font-size: var(--text-body-sm-size);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-ink);
		background-color: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-md);
	}

	.button-secondary:hover {
		background-color: var(--color-surface-2);
		border-color: var(--color-hairline-strong);
	}

	/* ---- Shared compact chip（Skills / Hero 共通） ---- */
	.stack-chip {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 32px;
		padding: 0 10px 0 9px;
		border-radius: var(--rounded-md);
		background: var(--color-surface-2);
		border: 1px solid var(--color-hairline);
		color: var(--color-ink);
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;
	}

	.stack-chip:hover {
		border-color: var(--color-hairline-strong);
		background: var(--color-surface-3);
	}

	.chip-label {
		font-size: 13px;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	/* ---- Hero ---- */
	.hero {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: var(--space-xxl);
		align-items: center;
		padding-top: calc(var(--space-section) - 16px);
		min-height: calc(100dvh - var(--nav-height) - var(--space-xxl));
	}

	.hero-name {
		margin-top: var(--space-xs);
	}

	.hero-tagline {
		max-width: 36em;
		margin-top: var(--space-lg);
		color: var(--color-ink-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xl);
	}

	.hero-panel {
		position: relative;
		padding: var(--space-lg);
		background-color: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xl);
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 8%, transparent);
	}

	.panel-chrome {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: var(--space-md);
	}

	.chrome-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-hairline-strong);
	}

	.chrome-title {
		margin-left: auto;
		color: var(--color-ink-tertiary);
		font-family: var(--font-mono);
	}

	.panel-role {
		color: var(--color-ink-subtle);
		margin-bottom: var(--space-md);
		padding-bottom: var(--space-md);
		border-bottom: 1px solid var(--color-hairline);
	}

	.panel-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.reveal {
		animation: rise 0.55s ease both;
	}

	.reveal-delay {
		animation-delay: 0.12s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* ---- About ---- */
	.about-grid {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: var(--space-xxl);
	}

	.about-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		color: var(--color-ink-muted);
	}

	.stats {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.stat-card {
		padding: var(--space-md) var(--space-lg);
		background-color: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-lg);
	}

	.stat-label {
		color: var(--color-ink-subtle);
	}

	.stat-value {
		margin-top: var(--space-xxs);
	}

	/* ---- Skills（コンパクトな行レイアウト） ---- */
	.skills-board {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		padding: var(--space-xl);
		background: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xl);
	}

	.skill-row {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: var(--space-md);
		align-items: center;
	}

	.skill-category {
		color: var(--color-ink-subtle);
		font-weight: 500;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.skill-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	/* ---- Projects ---- */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--space-md);
	}

	/* ---- Contact ---- */
	.contact-wrap {
		padding-top: var(--space-section);
	}

	.cta-banner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-xl);
		padding: var(--space-xxl);
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 10%, transparent), transparent 42%),
			var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xl);
	}

	.cta-copy {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.cta-body {
		max-width: 36em;
		color: var(--color-ink-muted);
	}

	@media (max-width: 1024px) {
		.projects-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			gap: var(--space-xl);
			padding-top: var(--space-xxl);
		}

		.about-grid,
		.projects-grid {
			grid-template-columns: 1fr;
		}

		.about-grid {
			gap: var(--space-xl);
		}

		.skill-row {
			grid-template-columns: 1fr;
			gap: var(--space-xs);
		}

		.skills-board {
			padding: var(--space-lg);
		}

		.cta-banner {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal,
		.reveal-delay {
			animation: none;
		}
	}
</style>
