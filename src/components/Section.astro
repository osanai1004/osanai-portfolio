---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section class="section container" id={id}>
	<p class="eyebrow">{eyebrow}</p>
	<h2 class="display-md section-title">{title}</h2>
	<slot />
</section>

<style>
	.section {
		padding-top: var(--space-section);
	}

	.section-title {
		margin-top: var(--space-xs);
		margin-bottom: var(--space-xl);
	}
</style>
