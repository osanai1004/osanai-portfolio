---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	/** セクション背後の雰囲気（余白の間延びを抑える） */
	atmosphere?: 'none' | 'about' | 'skills';
}

const { id, eyebrow, title, atmosphere = 'none' } = Astro.props;
const hasAtmosphere = atmosphere !== 'none';
---

<section
	class:list={['section', hasAtmosphere && 'section-band', hasAtmosphere && `atmosphere-${atmosphere}`]}
	id={id}
>
	{
		hasAtmosphere && (
			<div class="atmosphere" aria-hidden="true">
				<div class="atmosphere-glow atmosphere-glow-a"></div>
				<div class="atmosphere-glow atmosphere-glow-b"></div>
				<div class="atmosphere-grid"></div>
				<div class="atmosphere-fade atmosphere-fade-top"></div>
				<div class="atmosphere-fade atmosphere-fade-bottom"></div>
			</div>
		)
	}
	<div class="container section-inner">
		<p class="eyebrow">{eyebrow}</p>
		<h2 class="display-md section-title">{title}</h2>
		<slot />
	</div>
</section>

<style>
	.section {
		padding-top: var(--space-section);
	}

	.section-band {
		position: relative;
		isolation: isolate;
		padding-block: var(--space-section);
		margin-top: calc(var(--space-xl) * -1);
		overflow: hidden;
	}

	.section-inner {
		position: relative;
		z-index: 1;
	}

	.section-title {
		margin-top: var(--space-xs);
		margin-bottom: var(--space-xl);
	}

	.atmosphere {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.atmosphere-glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(48px);
		opacity: 0.55;
		will-change: transform;
	}

	.atmosphere-glow-a {
		width: min(52vw, 520px);
		height: min(52vw, 520px);
		top: -12%;
		right: -8%;
		background: radial-gradient(
			circle at 40% 40%,
			color-mix(in srgb, var(--color-primary) 34%, transparent),
			transparent 68%
		);
		animation: drift-a 18s ease-in-out infinite alternate;
	}

	.atmosphere-glow-b {
		width: min(44vw, 440px);
		height: min(44vw, 440px);
		bottom: -18%;
		left: -6%;
		background: radial-gradient(
			circle at 50% 50%,
			color-mix(in srgb, var(--color-success) 18%, transparent),
			transparent 70%
		);
		animation: drift-b 22s ease-in-out infinite alternate;
	}

	.atmosphere-grid {
		position: absolute;
		inset: 0;
		opacity: 0.35;
		background-image:
			radial-gradient(color-mix(in srgb, var(--color-ink) 14%, transparent) 1px, transparent 1px),
			linear-gradient(
				to right,
				color-mix(in srgb, var(--color-hairline-strong) 55%, transparent) 1px,
				transparent 1px
			),
			linear-gradient(
				to bottom,
				color-mix(in srgb, var(--color-hairline-strong) 45%, transparent) 1px,
				transparent 1px
			);
		background-size:
			18px 18px,
			72px 72px,
			72px 72px;
		mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 20%, transparent 78%);
	}

	.atmosphere-fade {
		position: absolute;
		left: 0;
		right: 0;
		height: 88px;
	}

	.atmosphere-fade-top {
		top: 0;
		background: linear-gradient(to bottom, var(--color-canvas), transparent);
	}

	.atmosphere-fade-bottom {
		bottom: 0;
		background: linear-gradient(to top, var(--color-canvas), transparent);
	}

	/* About: 左寄りの光 + 斜めの薄い帯 */
	.atmosphere-about .atmosphere-glow-a {
		top: 8%;
		left: -10%;
		right: auto;
		background: radial-gradient(
			circle at 45% 45%,
			color-mix(in srgb, var(--color-primary) 30%, transparent),
			transparent 70%
		);
	}

	.atmosphere-about .atmosphere-glow-b {
		right: -4%;
		left: auto;
		bottom: 4%;
		background: radial-gradient(
			circle at 50% 50%,
			color-mix(in srgb, var(--color-primary-hover) 16%, transparent),
			transparent 72%
		);
	}

	.atmosphere-about .atmosphere-grid {
		transform: rotate(-4deg) scale(1.08);
		opacity: 0.28;
	}

	/* Skills: 右寄りの技術感 + やや強いドット */
	.atmosphere-skills .atmosphere-glow-a {
		top: -8%;
		right: 8%;
		background: radial-gradient(
			circle at 40% 40%,
			color-mix(in srgb, var(--color-primary) 28%, transparent),
			transparent 68%
		);
	}

	.atmosphere-skills .atmosphere-glow-b {
		left: 18%;
		bottom: -20%;
		background: radial-gradient(
			circle at 50% 50%,
			color-mix(in srgb, var(--color-success) 14%, transparent),
			transparent 70%
		);
	}

	.atmosphere-skills .atmosphere-grid {
		opacity: 0.4;
		background-size:
			16px 16px,
			64px 64px,
			64px 64px;
	}

	:global(:root[data-theme='light']) .atmosphere-glow {
		opacity: 0.4;
	}

	:global(:root[data-theme='light']) .atmosphere-grid {
		opacity: 0.22;
	}

	@keyframes drift-a {
		from {
			transform: translate3d(0, 0, 0) scale(1);
		}
		to {
			transform: translate3d(-28px, 22px, 0) scale(1.06);
		}
	}

	@keyframes drift-b {
		from {
			transform: translate3d(0, 0, 0) scale(1.04);
		}
		to {
			transform: translate3d(24px, -18px, 0) scale(1);
		}
	}

	@media (max-width: 768px) {
		.section-band {
			padding-block: var(--space-xxl);
			margin-top: 0;
		}

		.atmosphere-glow {
			filter: blur(36px);
			opacity: 0.4;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.atmosphere-glow-a,
		.atmosphere-glow-b {
			animation: none;
		}
	}
</style>
