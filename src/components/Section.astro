---
import Atmosphere from './Atmosphere.astro';

interface Props {
	id: string;
	eyebrow: string;
	title: string;
	/** セクション背後の雰囲気（余白の間延びを抑える） */
	atmosphere?: 'none' | 'about' | 'skills';
}

const { id, eyebrow, title, atmosphere = 'none' } = Astro.props;
const hasAtmosphere = atmosphere !== 'none';
---

<section
	class:list={['section', hasAtmosphere && 'section-band', hasAtmosphere && `atmosphere-${atmosphere}`]}
	id={id}
>
	{hasAtmosphere && <Atmosphere variant={atmosphere} />}
	<div class="container section-inner">
		<p class="eyebrow">{eyebrow}</p>
		<h2 class="display-md section-title">{title}</h2>
		<slot />
	</div>
</section>

<style>
	.section {
		padding-top: var(--space-section);
	}

	.section-band {
		position: relative;
		isolation: isolate;
		padding-block: var(--space-section);
		margin-top: calc(var(--space-xl) * -1);
		overflow: hidden;
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--color-surface-1) 55%, transparent),
				color-mix(in srgb, var(--color-surface-2) 70%, transparent) 48%,
				color-mix(in srgb, var(--color-surface-1) 45%, transparent)
			);
	}

	.section-inner {
		position: relative;
		z-index: 1;
	}

	.section-title {
		margin-top: var(--space-xs);
		margin-bottom: var(--space-xl);
	}

	:global(:root[data-theme='light']) .section-band {
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--color-surface-3) 80%, transparent),
				color-mix(in srgb, var(--color-surface-1) 92%, transparent) 50%,
				color-mix(in srgb, var(--color-surface-3) 70%, transparent)
			);
	}

	@media (max-width: 768px) {
		.section-band {
			padding-block: var(--space-xxl);
			margin-top: 0;
		}
	}
</style>
