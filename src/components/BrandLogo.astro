---
/**
 * Simple Icons 由来の公式 SVG を <img> で表示（CSP の style-src 'self' に適合）。
 * 色は SVG 自体にブランドカラーを焼き込み済み。
 */
import { BRANDS, type BrandId } from '../lib/brands';

interface Props {
	id: BrandId;
	/** 表示サイズ（px） */
	size?: number;
}

const { id, size = 16 } = Astro.props;
const brand = BRANDS[id];
const needsThemeSwap = brand.color === 'ink';
---

{
	needsThemeSwap ? (
		<span class="brand-logo-wrap">
			<img
				class="brand-logo logo-dark"
				src={`/icons/${brand.file}`}
				alt=""
				width={size}
				height={size}
				decoding="async"
			/>
			<img
				class="brand-logo logo-light"
				src={`/icons/${id}-light.svg`}
				alt=""
				width={size}
				height={size}
				decoding="async"
			/>
			<span class="sr-only">{brand.label}</span>
		</span>
	) : (
		<img
			class="brand-logo"
			src={`/icons/${brand.file}`}
			alt={brand.label}
			width={size}
			height={size}
			decoding="async"
		/>
	)
}

<style>
	.brand-logo {
		display: block;
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		object-fit: contain;
	}

	/* size は width/height 属性で指定。CSS は既定 16px に固定して揃える */
	.brand-logo-wrap {
		display: inline-flex;
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		position: relative;
	}

	.brand-logo-wrap .brand-logo {
		position: absolute;
		inset: 0;
		width: 16px;
		height: 16px;
	}

	.logo-light {
		display: none;
	}

	:global([data-theme='light']) .logo-dark {
		display: none;
	}

	:global([data-theme='light']) .logo-light {
		display: block;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
