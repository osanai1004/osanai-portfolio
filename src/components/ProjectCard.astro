---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/site';
import { useTranslations, type UiKey } from '../lib/i18n/ui';
import { PROJECT_IMAGES, type ProjectVisual } from '../lib/brands';

interface Props {
	project: CollectionEntry<'projects'>;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const typeLabel = t(`projects.type.${project.data.type}` as UiKey);
const visual = project.data.visual as ProjectVisual;
const image = PROJECT_IMAGES[visual];
---

<article class="project-card">
	<div class="visual">
		<img src={image.src} alt={image.alt} width="1200" height="675" loading="lazy" decoding="async" />
	</div>
	<div class="card-body">
		<div class="card-head">
			<h3 class="card-title">{project.data.title}</h3>
			<span class="status-badge caption">{typeLabel}</span>
		</div>
		<p class="body-sm summary">{project.data.summary}</p>
		<ul class="tech-list" aria-label="Tech stack">
			{project.data.tech.map((item) => <li class="tech-item caption">{item}</li>)}
		</ul>
		{
			project.data.links && (
				<div class="links">
					{project.data.links.site && (
						<a class="link body-sm" href={project.data.links.site} rel="noopener noreferrer" target="_blank">
							{t('projects.link.site')} ↗
						</a>
					)}
					{project.data.links.github && (
						<a
							class="link body-sm"
							href={project.data.links.github}
							rel="noopener noreferrer"
							target="_blank"
						>
							{t('projects.link.github')} ↗
						</a>
					)}
				</div>
			)
		}
	</div>
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background-color: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xl);
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease,
			transform 0.2s ease;
	}

	.project-card:hover {
		background-color: var(--color-surface-2);
		border-color: var(--color-hairline-strong);
		transform: translateY(-2px);
	}

	.visual {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-bottom: 1px solid var(--color-hairline);
		background: var(--color-surface-2);
	}

	.visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s ease;
	}

	.project-card:hover .visual img {
		transform: scale(1.03);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		padding: var(--space-lg);
		flex-grow: 1;
	}

	.card-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	.status-badge {
		flex-shrink: 0;
		padding: 2px var(--space-xs);
		color: var(--color-ink-muted);
		background-color: var(--color-surface-2);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-pill);
	}

	.summary {
		color: var(--color-ink-muted);
		flex-grow: 1;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}

	.tech-item {
		font-family: var(--font-mono);
		padding: 2px var(--space-xs);
		color: var(--color-ink-subtle);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xs);
	}

	.links {
		display: flex;
		gap: var(--space-md);
	}

	.link {
		font-weight: 500;
		color: var(--color-primary);
	}

	.link:hover {
		color: var(--color-primary-hover);
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card,
		.visual img {
			transition: none;
		}

		.project-card:hover {
			transform: none;
		}

		.project-card:hover .visual img {
			transform: none;
		}
	}
</style>
