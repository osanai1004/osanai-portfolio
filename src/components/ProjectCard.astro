---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../lib/site';
import { useTranslations, type UiKey } from '../lib/i18n/ui';

interface Props {
	project: CollectionEntry<'projects'>;
	locale: Locale;
}

const { project, locale } = Astro.props;
const t = useTranslations(locale);
const typeLabel = t(`projects.type.${project.data.type}` as UiKey);
---

<article class="project-card">
	<div class="card-head">
		<h3 class="card-title">{project.data.title}</h3>
		<span class="status-badge caption">{typeLabel}</span>
	</div>
	<p class="body-sm summary">{project.data.summary}</p>
	<ul class="tech-list" aria-label="Tech stack">
		{project.data.tech.map((item) => <li class="tech-item caption">{item}</li>)}
	</ul>
	{
		project.data.links && (
			<div class="links">
				{project.data.links.site && (
					<a class="link body-sm" href={project.data.links.site} rel="noopener noreferrer" target="_blank">
						{t('projects.link.site')} ↗
					</a>
				)}
				{project.data.links.github && (
					<a class="link body-sm" href={project.data.links.github} rel="noopener noreferrer" target="_blank">
						{t('projects.link.github')} ↗
					</a>
				)}
			</div>
		)
	}
</article>

<style>
	/* DESIGN.md: feature-card — surface-1 / hairline 1px / rounded-lg / padding 24px */
	.project-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		padding: var(--space-lg);
		background-color: var(--color-surface-1);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-lg);
	}

	.project-card:hover {
		background-color: var(--color-surface-2);
		border-color: var(--color-hairline-strong);
	}

	.card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-sm);
	}

	/* DESIGN.md: status-badge — surface-2 / ink-muted / pill */
	.status-badge {
		flex-shrink: 0;
		padding: 2px var(--space-xs);
		color: var(--color-ink-muted);
		background-color: var(--color-surface-2);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-pill);
	}

	.summary {
		color: var(--color-ink-muted);
		flex-grow: 1;
	}

	.tech-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
	}

	.tech-item {
		font-family: var(--font-mono);
		padding: 2px var(--space-xs);
		color: var(--color-ink-subtle);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-xs);
	}

	.links {
		display: flex;
		gap: var(--space-md);
	}

	.link {
		font-weight: 500;
		color: var(--color-primary);
	}

	.link:hover {
		color: var(--color-primary-hover);
	}
</style>
