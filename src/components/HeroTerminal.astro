---
import type { Locale } from '../lib/site';
import { useTranslations } from '../lib/i18n/ui';
import {
	HERO_TERMINAL_VARIANTS,
	HERO_TERMINAL_SCRIPTS,
	HERO_TERMINAL_CHROME,
	HERO_TERMINAL_SWITCH,
	formatHeroTerminalTranscript,
} from '../lib/hero-terminal';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prompt = t('hero.terminal.prompt');
---

<div class="hero-terminal" data-hero-terminal>
	<div class="cli-switcher" role="tablist" aria-label={t('hero.cli.nav')}>
		{
			HERO_TERMINAL_VARIANTS.map((variant) => (
				<button
					class="cli-tab"
					type="button"
					role="tab"
					data-cli-tab={variant}
					aria-selected={variant === 'c' ? 'true' : 'false'}
				>
					{t(HERO_TERMINAL_SWITCH[variant])}
				</button>
			))
		}
	</div>
	{
		HERO_TERMINAL_VARIANTS.map((variant) => (
			<div class="cli-pane" data-cli-pane={variant} hidden={variant !== 'c'}>
				<pre class="sr-only">{formatHeroTerminalTranscript(t, HERO_TERMINAL_SCRIPTS[variant])}</pre>
				<div
					class="hero-terminal-screen"
					data-terminal-screen
					data-cli-chrome={t(HERO_TERMINAL_CHROME[variant])}
					aria-hidden="true"
				>
					{
						HERO_TERMINAL_SCRIPTS[variant].map((step) => {
							if (step.kind === 'blank') {
								return (
									<p class="term-line term-blank" data-term-line="blank">
										&nbsp;
									</p>
								);
							}
							if (step.kind === 'command') {
								return (
									<p class="term-line term-command" data-term-line="command">
										<span class="term-prompt">{prompt}</span>
										<span class="term-cmd" data-term-type>
											{t(step.cmdKey)}
										</span>
									</p>
								);
							}
							return (
								<p
									class:list={['term-line', 'term-output', `term-output-${step.tone}`]}
									data-term-line="output"
									data-term-tone={step.tone}
								>
									<span data-term-type>{t(step.textKey)}</span>
								</p>
							);
						})
					}
				</div>
			</div>
		))
	}
</div>

<style>
	.hero-terminal {
		position: relative;
	}

	.cli-switcher {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xxs);
		margin-bottom: var(--space-sm);
	}

	.cli-tab {
		min-height: 32px;
		padding-inline: var(--space-sm);
		font-family: var(--font-mono);
		font-size: var(--text-caption-size);
		font-weight: 500;
		color: var(--color-ink-subtle);
		background-color: var(--color-surface-2);
		border: 1px solid var(--color-hairline);
		border-radius: var(--rounded-md);
	}

	.cli-tab:hover {
		color: var(--color-ink);
		border-color: var(--color-hairline-strong);
	}

	.cli-tab[aria-selected='true'] {
		color: var(--color-ink);
		border-color: var(--color-hairline-strong);
		background-color: var(--color-surface-3);
	}

	.hero-terminal-screen {
		min-height: calc(var(--text-body-sm-size) * 1.55 * 12);
		font-family: var(--font-mono);
		font-size: var(--text-body-sm-size);
		line-height: 1.55;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	:global(html[data-terminal-motion='on']) .hero-terminal-screen:not([data-playing]) {
		visibility: hidden;
	}

	.term-line {
		margin: 0;
	}

	.term-blank {
		min-height: 1.55em;
	}

	.term-prompt {
		color: var(--color-primary);
		margin-right: 0.6ch;
	}

	.term-cmd {
		color: var(--color-ink);
	}

	.term-output-ink {
		color: var(--color-ink);
	}

	.term-output-muted {
		color: var(--color-ink-muted);
	}

	.term-output-success {
		color: var(--color-success);
	}

	.hero-terminal :global(.term-caret) {
		display: inline-block;
		width: 0.55ch;
		height: 1.05em;
		margin-left: 1px;
		background-color: var(--color-ink);
		vertical-align: -0.15em;
		animation: caret-blink 1s steps(1, end) infinite;
	}

	@keyframes caret-blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.term-caret {
			animation: none;
			opacity: 1;
		}
	}
</style>

<script>
	const COMMAND_CHAR_MS = 38;
	const OUTPUT_CHAR_MS = 24;
	const LINE_PAUSE_MS = 280;
	const LOOP_PAUSE_MS = 2200;
	const CLI_QUERY = 'cli';
	const CLI_VARIANTS = ['a', 'b', 'c'] as const;

	type CliVariant = (typeof CLI_VARIANTS)[number];

	function prefersReducedMotion(): boolean {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function wait(ms: number): Promise<void> {
		return new Promise((resolve) => {
			window.setTimeout(resolve, ms);
		});
	}

	function parseVariant(value: string | null): CliVariant {
		return CLI_VARIANTS.find((item) => item === value) ?? 'c';
	}

	function variantFromLocation(): CliVariant {
		return parseVariant(new URL(window.location.href).searchParams.get(CLI_QUERY));
	}

	function writeVariantToUrl(variant: CliVariant): void {
		const url = new URL(window.location.href);
		if (variant === 'c') {
			url.searchParams.delete(CLI_QUERY);
		} else {
			url.searchParams.set(CLI_QUERY, variant);
		}
		window.history.replaceState({}, '', url);
	}

	function appendCaret(target: HTMLElement): HTMLElement {
		const caret = document.createElement('span');
		caret.className = 'term-caret';
		caret.setAttribute('aria-hidden', 'true');
		target.append(caret);
		return caret;
	}

	function clearCarets(screen: HTMLElement): void {
		screen.querySelectorAll('.term-caret').forEach((caret) => caret.remove());
	}

	async function typeInto(target: HTMLElement, text: string, charMs: number): Promise<void> {
		target.textContent = '';
		const caret = appendCaret(target);
		for (const char of text) {
			caret.before(document.createTextNode(char));
			await wait(charMs);
		}
		caret.remove();
	}

	async function playSession(
		lines: HTMLElement[],
		texts: Map<HTMLElement, string>,
		isCurrent: () => boolean,
	): Promise<void> {
		for (const line of lines) {
			line.hidden = true;
			const typed = line.querySelector<HTMLElement>('[data-term-type]');
			if (typed) {
				typed.textContent = '';
			}
		}

		for (const line of lines) {
			if (!isCurrent()) {
				return;
			}
			line.hidden = false;
			const typed = line.querySelector<HTMLElement>('[data-term-type]');
			if (typed) {
				const text = texts.get(typed) ?? '';
				const charMs = line.dataset.termLine === 'command' ? COMMAND_CHAR_MS : OUTPUT_CHAR_MS;
				await typeInto(typed, text, charMs);
			}
			await wait(LINE_PAUSE_MS);
		}

		const lastTyped = lines.at(-1)?.querySelector<HTMLElement>('[data-term-type]');
		if (lastTyped && isCurrent()) {
			appendCaret(lastTyped);
		}
	}

	function bindTerminal(root: HTMLElement): void {
		const panes = Array.from(root.querySelectorAll<HTMLElement>('[data-cli-pane]'));
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cli-tab]'));
		const chrome = document.querySelector<HTMLElement>('[data-cli-chrome-title]');
		const snapshots = new Map<HTMLElement, Map<HTMLElement, string>>();
		let playId = 0;

		for (const pane of panes) {
			const screen = pane.querySelector<HTMLElement>('[data-terminal-screen]');
			if (!screen) {
				continue;
			}
			const texts = new Map<HTMLElement, string>();
			for (const typed of screen.querySelectorAll<HTMLElement>('[data-term-type]')) {
				texts.set(typed, typed.textContent ?? '');
			}
			snapshots.set(screen, texts);
		}

		function showPane(variant: CliVariant): HTMLElement | null {
			let active: HTMLElement | null = null;
			for (const pane of panes) {
				const isActive = pane.dataset.cliPane === variant;
				pane.hidden = !isActive;
				if (isActive) {
					active = pane;
				}
			}
			for (const tab of tabs) {
				tab.setAttribute('aria-selected', tab.dataset.cliTab === variant ? 'true' : 'false');
			}
			const screen = active?.querySelector<HTMLElement>('[data-terminal-screen]') ?? null;
			if (chrome && screen?.dataset.cliChrome) {
				chrome.textContent = screen.dataset.cliChrome;
			}
			return screen;
		}

		async function runScreen(screen: HTMLElement): Promise<void> {
			const id = ++playId;
			const isCurrent = () => id === playId;

			if (prefersReducedMotion()) {
				screen.dataset.playing = 'true';
				return;
			}

			const lines = Array.from(screen.querySelectorAll<HTMLElement>('[data-term-line]'));
			const texts = snapshots.get(screen) ?? new Map<HTMLElement, string>();
			screen.dataset.playing = 'true';
			if (lines.length === 0) {
				return;
			}

			while (document.contains(root) && isCurrent()) {
				clearCarets(screen);
				await playSession(lines, texts, isCurrent);
				if (!isCurrent()) {
					return;
				}
				await wait(LOOP_PAUSE_MS);
			}
		}

		function activate(variant: CliVariant, writeUrl: boolean): void {
			const screen = showPane(variant);
			if (writeUrl) {
				writeVariantToUrl(variant);
			}
			if (screen) {
				void runScreen(screen);
			}
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				activate(parseVariant(tab.dataset.cliTab ?? 'c'), true);
			});
		});

		window.addEventListener('popstate', () => {
			activate(variantFromLocation(), false);
		});

		activate(variantFromLocation(), false);
	}

	document.querySelectorAll<HTMLElement>('[data-hero-terminal]').forEach((root) => {
		bindTerminal(root);
	});
</script>
