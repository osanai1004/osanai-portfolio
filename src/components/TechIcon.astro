---
/**
 * 技術スタック用のモノクロ SVG アイコン（セルフホスト・CSP img-src 'self' 準拠のためインライン）
 * Linear の単一アクセント方針に合わせ、色は currentColor のみ。
 */
interface Props {
	id: string;
	size?: number;
}

const { id, size = 24 } = Astro.props;
---

<span class="tech-icon" style={`--icon-size: ${size}px`} aria-hidden="true">
	{
		id === 'php' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
				<path d="M3 12h18" />
				<ellipse cx="12" cy="12" rx="9" ry="6.5" />
				<path d="M8 10.2v3.6M7 12h2.2M12.2 10.2l1.4 3.6 1.4-3.6M17.2 13.8V10.2h1.4a1.2 1.2 0 0 1 0 2.4H17.2" />
			</svg>
		) : id === 'laravel' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
				<path d="m4 8 4-2 4 2v4l-4 2-4-2V8Z" />
				<path d="m12 10 4-2 4 2v4l-4 2-4-2" />
				<path d="M8 14v4l4 2 4-2v-4" />
			</svg>
		) : id === 'aws' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
				<path d="M5 15c2 2.5 5 3.8 7 3.8s5-1.3 7-3.8" />
				<path d="M8 6.5 12 5l4 1.5v5.2L12 13 8 11.7V6.5Z" />
				<path d="M12 5v8" />
			</svg>
		) : id === 'docker' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
				<path d="M3 13.5h13.5a4 4 0 0 1 0 8H8.5A5.5 5.5 0 0 1 4 16.5" />
				<path d="M5.5 13.5V10h2.2v3.5M8.5 13.5V8.5h2.2v5M11.5 13.5V10h2.2v3.5M8.5 8.5V6.2h2.2v2.3" />
			</svg>
		) : id === 'astro' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
				<path d="M12 3 6.5 17.5h3.2l.8-2.3h3l.8 2.3h3.2L12 3Z" />
				<path d="M10.8 12.5h2.4" />
				<path d="M14.5 19c.8 1.4 2.2 2 3.5 2-2.2.4-4.2-.4-5.2-2.2C11.8 20.6 9.8 21.4 7.6 21c1.3 0 2.7-.6 3.5-2" />
			</svg>
		) : id === 'nextjs' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
				<circle cx="12" cy="12" r="8.5" />
				<path d="M9 8.5v7M9 8.5h3.2a2.4 2.4 0 0 1 0 4.8H9M14.5 15.5 18 8.5" />
			</svg>
		) : id === 'typescript' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
				<rect x="3.5" y="3.5" width="17" height="17" rx="2.5" />
				<path d="M8 9.5h8M12 9.5V17" />
			</svg>
		) : id === 'github' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
				<path d="M9.5 19.5c-4 1.3-4-2-5.5-2.5M15.5 21v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.3 1.2a11.3 11.3 0 0 0-6 0C7.2 3.1 6.2 3.4 6.2 3.4a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.8 9.8c0 4.7 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V21" />
			</svg>
		) : id === 'actions' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
				<path d="M5 6h6M5 12h10M5 18h8" />
				<path d="m15 5 4 3-4 3M17 13l4 3-4 3" />
			</svg>
		) : id === 'ai' ? (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
				<path d="M12 3.5 14.2 9H20l-4.5 3.4L17.2 18 12 14.8 6.8 18l1.7-5.6L4 9h5.8L12 3.5Z" />
			</svg>
		) : (
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
				<circle cx="12" cy="12" r="7.5" />
			</svg>
		)
	}
</span>

<style>
	.tech-icon {
		display: inline-flex;
		width: var(--icon-size);
		height: var(--icon-size);
		color: inherit;
		flex-shrink: 0;
	}

	.tech-icon :global(svg) {
		width: 100%;
		height: 100%;
	}
</style>
